---
import SectionLabel from '../ui/SectionLabel.astro';
import { getUnifiedGitActivity } from '../../lib/api/activity';
import { getLeetCodeStats } from '../../lib/api/leetcode';
import { GitActivityCard } from './metrics/git-activity-card';
import { LeetCodeCard } from './metrics/leetcode-card';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const [gitData, leetcodeStats, gitPrev1, gitPrev2] = await Promise.all([
  getUnifiedGitActivity(currentYear),
  getLeetCodeStats(),
  getUnifiedGitActivity(currentYear - 1),
  getUnifiedGitActivity(currentYear - 2),
]);

const yearCache: Record<number, any> = {
  [currentYear]: gitData,
  [currentYear - 1]: gitPrev1,
  [currentYear - 2]: gitPrev2,
};

console.log(`[ActivitySection] Lang: ${lang} | Git 2026: ${gitData.totalContributions} | All-time: ${gitData.allTimeTotal} | Languages: ${gitData.languages.length} | LeetCode Solved: ${leetcodeStats.totalSolved}`);
---

<section class="activity-section section" id="activity" aria-label={t('activity.section_label')}>
  <div class="container">
    <header class="activity-section__header">
      <SectionLabel label={t('activity.section_label')} />
      <h2 class="activity-section__title">
        {t('activity.title')}
      </h2>
    </header>

    <div class="activity-grid">
      <LeetCodeCard client:load stats={leetcodeStats} lang={lang} />
      <GitActivityCard client:load initialData={gitData} yearCache={yearCache} lang={lang} />
    </div>
  </div>
</section>

<style>
  .activity-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
    border-bottom: var(--border-width) solid var(--color-border-soft);
  }

  .activity-section__header {
    margin-bottom: var(--space-8);
  }

  .activity-section__title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    margin-top: var(--space-2);
    color: var(--color-fg);
  }

  @media (max-width: 768px) {
    .activity-section {
      padding-top: var(--space-8);
      padding-bottom: var(--space-12);
    }

    .activity-section__title {
      font-size: var(--text-3xl);
    }
  }
</style>
