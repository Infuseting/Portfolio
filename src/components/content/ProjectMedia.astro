---
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  presentation?: 'logo' | 'screenshot' | 'photo';
  widths: number[];
  sizes: string;
  loading?: 'eager' | 'lazy';
}

const {
  src,
  alt,
  presentation = 'screenshot',
  widths,
  sizes,
  loading = 'lazy',
} = Astro.props;

// Keep animated GIFs animated and SVGs vectorial. Sharp converts raster stills.
const keepOriginal = src.format === 'gif' || src.format === 'svg';
const outputWidths = [...new Set([...widths.filter((width) => width <= src.width), src.width])].sort((a, b) => a - b);
const fallbackFormat: 'png' | 'jpeg' = src.format === 'png' ? 'png' : 'jpeg';
---

<div class:list={['project-media', `project-media--${presentation}`]}>
  {keepOriginal ? (
    <Image src={src} alt={alt} widths={outputWidths} sizes={sizes} loading={loading} />
  ) : (
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      fallbackFormat={fallbackFormat}
      widths={outputWidths}
      sizes={sizes}
      loading={loading}
    />
  )}
  <span class="project-media__loading-bar" aria-hidden="true"></span>
</div>

<script>
  import { startLoadingScanline } from '../../lib/motion/loading-scan';

  function initProjectMedia() {
    document.querySelectorAll<HTMLElement>('.project-media:not([data-media-init])').forEach((frame) => {
      frame.setAttribute('data-media-init', '');
      const image = frame.querySelector('img');
      if (!image || image.complete) return;

      const bar = frame.querySelector<HTMLElement>('.project-media__loading-bar');
      frame.setAttribute('data-loading', '');
      const stopScan = bar ? startLoadingScanline(bar) : () => {};
      const finish = () => {
        stopScan();
        frame.removeAttribute('data-loading');
      };
      image.addEventListener('load', finish, { once: true });
      image.addEventListener('error', finish, { once: true });
      if (image.complete) finish();
    });
  }

  initProjectMedia();
  document.addEventListener('astro:page-load', initProjectMedia);
</script>

<style>
  .project-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-bg-alt);
  }

  .project-media--logo { background: #152039; }
  .project-media--screenshot { background: #e9e4dc; }

  .project-media :global(picture),
  .project-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .project-media :global(img) {
    object-fit: cover;
    object-position: center;
  }

  .project-media__loading-bar {
    position: absolute;
    inset: auto auto 0 0;
    width: 36%;
    height: 3px;
    background: var(--color-accent);
    pointer-events: none;
    opacity: 0;
  }

  .project-media[data-loading] .project-media__loading-bar { opacity: 1; }

</style>
