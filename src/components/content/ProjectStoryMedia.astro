---
import type { ImageMetadata } from 'astro';
import ProjectMedia from './ProjectMedia.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  presentation?: 'logo' | 'screenshot' | 'photo';
}

const {
  src,
  alt,
  caption,
  presentation = 'screenshot',
} = Astro.props;
---

<figure class="project-story-media">
  <ProjectMedia
    src={src}
    alt={alt}
    presentation={presentation}
    widths={[640, 960, 1440]}
    sizes="(max-width: 900px) 100vw, 66rem"
  />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .project-story-media {
    width: min(120%, 66rem);
    margin: var(--space-10) 50% var(--space-12);
    overflow: hidden;
    border: var(--border-width-thick) solid var(--color-border);
    background: var(--color-bg-alt);
    transform: translateX(-50%);
  }

  .project-story-media figcaption {
    padding: var(--space-3) var(--space-4);
    border-top: var(--border-width) solid var(--color-border);
    color: var(--color-fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  @media (max-width: 900px) {
    .project-story-media {
      width: 100%;
      margin-inline: 0;
      transform: none;
    }
  }
</style>
