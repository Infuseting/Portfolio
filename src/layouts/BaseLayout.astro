---
// BaseLayout.astro | HTML shell with SEO, theme, and ClientRouter
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/global.css';

interface Props {
  title:        string;
  description:  string;
  ogImage?:     string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  ogType?:      'website' | 'article';
  canonicalUrl?: string;
  publishDate?:  string;
  robots?:       string;
}

const {
  title,
  description,
  ogImage      = '/og-image.png',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageType = 'image/png',
  ogType       = 'website',
  canonicalUrl = Astro.url.href,
  publishDate,
  robots       = 'index, follow',
} = Astro.props;

import { getLangFromUrl, defaultLang, useTranslations, getAltLang } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t_layout = useTranslations(lang);
const altLang = getAltLang(lang);
const altUrl = Astro.url.href.includes(`/${lang}/`)
  ? Astro.url.href.replace(`/${lang}/`, `/${altLang}/`)
  : Astro.url.href;

const fullTitle = title === 'Arthur SERRET'
  ? `Arthur SERRET | ${t_layout('site.tagline')}`
  : `${title} | Arthur SERRET`;

const siteUrl = Astro.site?.origin ?? 'https://infuseting.fr';
---

<!doctype html>
<html lang={lang} data-theme="light" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <link rel="alternate" hreflang={lang} href={canonicalUrl} />
    <link rel="alternate" hreflang={altLang} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl.replace(`/${lang}/`, `/${defaultLang}/`)} />


    <!-- Primary Meta -->
    <title>{fullTitle}</title>
    <meta name="robots"      content={robots} />
    <meta name="description" content={description} />
    <meta name="author"      content="Arthur SERRET" />
    <meta name="generator"   content={Astro.generator} />
    <link rel="canonical"    href={canonicalUrl} />

    <!-- Theme Color -->
    <meta name="theme-color" content="#fcfbf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121214" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph -->
    <meta property="og:type"        content={ogType} />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={`${siteUrl}${ogImage}`} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:type"  content={ogImageType} />
    <meta property="og:image:alt"   content={fullTitle} />
    <meta property="og:site_name"   content="Arthur SERRET" />
    <meta property="og:locale"      content={t_layout('site.locale')} />
    {publishDate && <meta property="article:published_time" content={publishDate} />}

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={`${siteUrl}${ogImage}`} />
    <meta name="twitter:image:alt"   content={fullTitle} />

    <!-- Favicon -->
    <link rel="icon"             href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon"             href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- JSON-LD Structured Data (Person + WebSite + ProfilePage) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": `${siteUrl}/#person`,
          "name": "Arthur SERRET",
          "url": siteUrl,
          "image": `${siteUrl}/og-image.png`,
          "jobTitle": "Software Engineer",
          "worksFor": {
            "@type": "Organization",
            "name": "Sopra Steria"
          },
          "alumniOf": {
            "@type": "EducationalOrganization",
            "name": "ENSICAEN"
          },
          "description": description,
          "knowsAbout": [
            "Software Engineering",
            "Full-Stack Development",
            "Cybersecurity",
            "E-Payment",
            "TypeScript",
            "React",
            "Astro",
            "Java",
            "PHP"
          ],
          "sameAs": [
            "https://github.com/Infuseting",
            "https://www.linkedin.com/in/arthur-serret/"
          ]
        },
        {
          "@type": "WebSite",
          "@id": `${siteUrl}/#website`,
          "url": siteUrl,
          "name": "Arthur SERRET | Portfolio",
          "description": description,
          "publisher": {
            "@id": `${siteUrl}/#person`
          },
          "inLanguage": lang
        },
        {
          "@type": "ProfilePage",
          "@id": canonicalUrl,
          "url": canonicalUrl,
          "name": fullTitle,
          "isPartOf": {
            "@id": `${siteUrl}/#website`
          },
          "about": {
            "@id": `${siteUrl}/#person`
          },
          "mainEntity": {
            "@id": `${siteUrl}/#person`
          },
          "inLanguage": lang
        }
      ]
    })} />

    <!-- Astro View Transitions (ClientRouter) -->
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">{t_layout('a11y.skip')}</a>
    <div class="route-progress" id="route-progress" role="status" aria-live="polite" aria-hidden="true">
      <span class="route-progress__bar" aria-hidden="true"></span>
      <span class="route-progress__label">{t_layout('loading.page')}</span>
    </div>
    <slot />
    <Analytics />
    <SpeedInsights />

    <script>
      import { startLoadingScanline } from '../lib/motion/loading-scan';
      import { startPageMotion } from '../lib/motion/page-motion';

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let stopPageMotion: (() => void) | undefined;
      let stopProgressScan: (() => void) | undefined;
      let progressTimer: number | undefined;

      function stopRouteProgress() {
        window.clearTimeout(progressTimer);
        progressTimer = undefined;
        stopProgressScan?.();
        stopProgressScan = undefined;
        const progress = document.getElementById('route-progress');
        progress?.removeAttribute('data-active');
        progress?.setAttribute('aria-hidden', 'true');
      }

      document.addEventListener('astro:before-preparation', () => {
        stopRouteProgress();
        progressTimer = window.setTimeout(() => {
          const progress = document.getElementById('route-progress');
          progress?.setAttribute('data-active', '');
          progress?.setAttribute('aria-hidden', 'false');
          const bar = progress?.querySelector<HTMLElement>('.route-progress__bar');
          if (bar) stopProgressScan = startLoadingScanline(bar);
        }, 180);
      });
      document.addEventListener('astro:after-preparation', stopRouteProgress);
      window.addEventListener('pageshow', stopRouteProgress);

      function initPageMotion() {
        stopPageMotion?.();
        stopPageMotion = startPageMotion();
      }

      document.addEventListener('astro:page-load', () => {
        stopRouteProgress();
        initPageMotion();
      });
      document.addEventListener('astro:before-swap', () => {
        stopPageMotion?.();
        stopPageMotion = undefined;
      });
      reducedMotion.addEventListener('change', initPageMotion);
    </script>
  </body>
</html>
