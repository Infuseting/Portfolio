---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { useTranslations } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  toc?: Array<{ id: string; label: string }>;
  lang: 'fr' | 'en';
}

const { title, description, toc = [], lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout title={title} description={description}>
  <Header />

  <main id="main-content" class="legal-page">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="legal-breadcrumb" aria-label={t('breadcrumb.label')}>
        <ol role="list">
          <li>
            <a href={`/${lang}/`}>{t('legal.breadcrumb_home')}</a>
          </li>
          <li aria-hidden="true" class="breadcrumb-sep">/</li>
          <li aria-current="page">
            <span>{title}</span>
          </li>
        </ol>
      </nav>

      <!-- Header Section -->
      <header class="legal-header">
        <div class="legal-header__badge">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span>EU Legal & Compliance</span>
        </div>
        <h1 class="legal-header__title">{title}</h1>
        <div class="legal-header__meta">
          <span class="meta-item">
            <strong>{t('legal.last_updated')}</strong> {t('legal.date')}
          </span>
        </div>
      </header>

      <!-- Content Area with Table of Contents -->
      <div class="legal-layout">
        {toc.length > 0 && (
          <aside class="legal-sidebar" aria-label={t('legal.table_of_contents')}>
            <div class="legal-toc">
              <h2 class="legal-toc__title">{t('legal.table_of_contents')}</h2>
              <ul class="legal-toc__list" role="list">
                {toc.map(({ id, label }) => (
                  <li>
                    <a href={`#${id}`} class="legal-toc__link">
                      {label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )}

        <article class="legal-content">
          <slot />

          <footer class="legal-content__footer">
            <a href="#main-content" class="back-to-top">
              {t('legal.back_to_top')}
            </a>
          </footer>
        </article>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .legal-page {
    padding-top: calc(var(--header-h) + var(--space-8));
    padding-bottom: var(--space-20);
    min-height: 80vh;
  }

  /* Breadcrumb */
  .legal-breadcrumb {
    margin-bottom: var(--space-6);
  }

  .legal-breadcrumb ol {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    font-size: var(--text-sm);
    font-family: var(--font-mono);
  }

  .legal-breadcrumb a {
    color: var(--color-fg-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal-breadcrumb a:hover {
    color: var(--color-accent);
  }

  .breadcrumb-sep {
    color: var(--color-fg-subtle);
  }

  .legal-breadcrumb [aria-current="page"] {
    color: var(--color-fg);
    font-weight: var(--weight-bold);
  }

  /* Header */
  .legal-header {
    border: var(--border-width) solid var(--color-border);
    background: var(--color-bg-alt);
    padding: var(--space-8);
    box-shadow: var(--shadow-brutal);
    margin-bottom: var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .legal-header__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    background: var(--color-bg);
    border: 1px solid var(--color-border-soft);
    padding: var(--space-1) var(--space-3);
    max-width: fit-content;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 6px var(--color-accent);
  }

  .legal-header__title {
    font-size: clamp(var(--text-3xl), 4vw, var(--text-5xl));
    line-height: var(--leading-tight);
    color: var(--color-fg);
    margin: 0;
  }

  .legal-header__meta {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-fg-muted);
  }

  /* Layout with TOC */
  .legal-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--space-10);
    align-items: start;
  }

  @media (max-width: 900px) {
    .legal-layout {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  /* Sidebar TOC */
  .legal-sidebar {
    position: sticky;
    top: calc(var(--header-h) + var(--space-4));
  }

  .legal-toc {
    background: var(--color-bg-alt);
    border: var(--border-width) solid var(--color-border);
    padding: var(--space-5);
    box-shadow: var(--shadow-brutal);
  }

  .legal-toc__title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .legal-toc__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .legal-toc__link {
    display: block;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-fg-muted);
    text-decoration: none;
    padding: var(--space-1) var(--space-2);
    border-left: 2px solid transparent;
    transition: all var(--transition-fast);
  }

  .legal-toc__link:hover {
    color: var(--color-fg);
    border-left-color: var(--color-accent);
    background: var(--color-bg);
  }

  /* Article Content */
  .legal-content {
    background: var(--color-bg);
    border: var(--border-width) solid var(--color-border);
    padding: var(--space-8);
    box-shadow: var(--shadow-brutal);
  }

  @media (max-width: 600px) {
    .legal-content {
      padding: var(--space-5);
    }
  }

  .legal-content :global(section) {
    margin-bottom: var(--space-10);
    scroll-margin-top: calc(var(--header-h) + var(--space-8));
  }

  .legal-content :global(section:last-of-type) {
    margin-bottom: var(--space-6);
  }

  .legal-content :global(h2) {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--color-fg);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: var(--border-width) solid var(--color-border-soft);
  }

  .legal-content :global(h3) {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-fg);
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }

  .legal-content :global(p) {
    margin-bottom: var(--space-4);
    line-height: var(--leading-relaxed, 1.7);
    color: var(--color-fg-muted);
    max-width: 100%;
  }

  .legal-content :global(p strong) {
    color: var(--color-fg);
  }

  .legal-content :global(ul),
  .legal-content :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
    color: var(--color-fg-muted);
    line-height: 1.7;
  }

  .legal-content :global(li) {
    margin-bottom: var(--space-2);
  }

  .legal-content :global(li strong) {
    color: var(--color-fg);
  }

  .legal-content :global(.legal-callout) {
    background: var(--color-bg-alt);
    border-left: 4px solid var(--color-accent);
    padding: var(--space-4) var(--space-5);
    margin-block: var(--space-5);
    border-radius: var(--radius-sm);
  }

  .legal-content :global(.legal-callout p) {
    margin-bottom: 0;
    color: var(--color-fg);
    font-size: var(--text-sm);
  }

  .legal-content :global(.legal-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
    margin-block: var(--space-5);
  }

  .legal-content :global(.legal-card) {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border-soft);
    padding: var(--space-4);
    border-radius: var(--radius-sm);
  }

  .legal-content :global(.legal-card h4) {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-fg);
    margin-bottom: var(--space-2);
  }

  .legal-content :global(.legal-card p) {
    font-size: var(--text-xs);
    margin: 0;
  }

  .legal-content__footer {
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-soft);
    display: flex;
    justify-content: flex-end;
  }

  .back-to-top {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    text-decoration: none;
    font-weight: var(--weight-bold);
  }

  .back-to-top:hover {
    text-decoration: underline;
  }
</style>
