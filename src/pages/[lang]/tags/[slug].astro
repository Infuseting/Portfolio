---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import Tag from '../../../components/ui/Tag.astro';
import SectionLabel from '../../../components/ui/SectionLabel.astro';
import { useTranslations } from '../../../i18n/utils';
import { defaultLang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const allTags = await getCollection('tags');
  const allProjects = await getCollection('projects');

  const langs = ['fr', 'en'];
  const paths = [];

  for (const lang of langs) {
    const uniqueTagNames = new Set<string>();
    
    allProjects
      .filter(p => p.id.startsWith(`${lang}/`))
      .forEach(p => p.data.tags?.forEach((t: string) => uniqueTagNames.add(t)));

    const handledNames = new Set<string>();

    for (const tag of allTags) {
      const tagLabel: string = typeof tag.data.name === 'string' 
        ? tag.data.name 
        : ((tag.data.name as Record<string, string>)?.[lang] || (tag.data.name as Record<string, string>)?.[defaultLang] || '');
      handledNames.add(tag.id.toLowerCase());
      handledNames.add(tagLabel.toLowerCase());
      paths.push({
        params: { lang, slug: tag.id },
        props: { tag: { id: tag.id, data: { ...tag.data, name: tagLabel } } }
      });
    }

    for (const tagName of uniqueTagNames) {
      if (!handledNames.has(tagName.toLowerCase())) {
        const slug = tagName.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
        paths.push({
          params: { lang, slug },
          props: { 
            tag: { id: slug, data: { name: tagName } }
          }
        });
        handledNames.add(tagName.toLowerCase());
      }
    }
  }

  return paths;
}

export interface Props {
  tag: {
    id: string;
    data: {
      name: string;
      color?: string;
      [key: string]: any;
    };
  };
}

const { lang } = Astro.params as { lang: 'fr' | 'en' };
const { tag } = Astro.props;
const t = useTranslations(lang);

const [allProjects, allTags] = await Promise.all([
  getCollection('projects'),
  getCollection('tags')
]);

const matchTag = (tagArr: string[]) => tagArr.some((t: string) => 
  t.toLowerCase() === tag.id.toLowerCase() || 
  t.toLowerCase() === tag.data.name.toLowerCase()
);

const projects = allProjects.filter((p: any) => matchTag(p.data.tags || []) && p.id.startsWith(`${lang}/`)).sort((a: any, b: any) => a.data.order - b.data.order);
---

<Layout title={`${t('tag.title')}: ${tag.data.name} | Arthur SERRET`} description={`${t('tag.meta_description').replace('{{tag}}', tag.data.name)}`}>
  <Header />
  <main class="tag-page section container" id="main-content" style="padding-top: var(--header-h);">
    <header class="tag-header">
      <SectionLabel label={t('tag.section_label')} />
      <h1 class="title" style={`--tag-color: ${(tag.data as any).color || 'var(--color-accent)'}`}>
        {tag.data.name}
      </h1>
      <p class="subtitle">{t('tag.subtitle')}</p>
    </header>

    {projects.length > 0 && (
      <section class="tag-section">
        <h2 class="section-title">{t('nav.projects')}</h2>
        <ul class="projects__grid" role="list">
          {projects.map((project: any) => (
            <li class="project-card">
              <article>
                <div class="project-card__header">
                  <span class="project-card__year">{project.data.year}</span>
                  <div class="project-card__links">
                    {project.data.liveUrl && (
                      <a href={project.data.liveUrl} target="_blank" rel="noopener noreferrer" class="project-card__link" aria-label={`Voir ${project.data.title} en ligne`}>↗</a>
                    )}
                  </div>
                </div>
                <h3 class="project-card__title">{project.data.title}</h3>
                <p class="project-card__desc">{project.data.description}</p>
                <ul class="project-card__tags">
                  {project.data.tags.map((t: string) => (
                    <li><Tag label={t} allTags={allTags} allProjects={allProjects} /></li>
                  ))}
                </ul>
              </article>
            </li>
          ))}
        </ul>
      </section>
    )}

    {projects.length === 0 && (
      <p class="empty-state">{t('tag.empty')}</p>
    )}
    
    <div class="back-link">
      <a href={`/${lang}/`}>&larr; {t('button.back_home')}</a>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .tag-page {
    padding-top: var(--space-24);
    padding-bottom: var(--space-24);
  }
  .tag-header {
    margin-bottom: var(--space-12);
  }
  .title {
    font-size: clamp(var(--text-4xl), 5vw, var(--text-6xl));
    color: var(--tag-color);
  }
  .subtitle {
    font-size: var(--text-lg);
    color: var(--color-fg-muted);
    margin-top: var(--space-4);
  }

  .tag-section {
    margin-bottom: var(--space-12);
  }
  .section-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-6);
    border-bottom: var(--border-width) solid var(--color-border-soft);
    padding-bottom: var(--space-2);
  }

  /* Projects Grid */
  .projects__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-6);
    list-style: none;
  }
  .project-card {
    border: var(--border-width) solid var(--color-border);
    transition: transform var(--transition-brutal), box-shadow var(--transition-brutal);
    padding: var(--space-6);
    background: var(--color-bg);
  }
  .project-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-brutal-hover);
  }
  .project-card__header {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }
  .project-card__year {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-fg-subtle);
  }
  .project-card__title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
  }
  .project-card__desc {
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }
  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }
  .project-card__link {
    border: var(--border-width) solid var(--color-border);
    padding: 2px 8px;
    text-decoration: none;
    color: var(--color-fg);
  }
  .project-card__link:hover {
    background: var(--color-fg);
    color: var(--color-bg);
  }



  .empty-state {
    font-style: italic;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-8);
  }

  .back-link {
    margin-top: var(--space-12);
  }
  .back-link a {
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    text-decoration: none;
  }
  .back-link a:hover {
    text-decoration: underline;
  }
</style>
