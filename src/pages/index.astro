<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Arthur SERRET — Software Engineer</title>
  <meta name="robots" content="noindex, follow">
  <link rel="canonical" href="https://infuseting.fr/fr/">
  <link rel="alternate" hreflang="fr" href="https://infuseting.fr/fr/">
  <link rel="alternate" hreflang="en" href="https://infuseting.fr/en/">
  <link rel="alternate" hreflang="x-default" href="https://infuseting.fr/fr/">
  <meta http-equiv="refresh" content="0;url=/fr/">
  <script>
    (function() {
      const storedLang = localStorage.getItem('lang');
      const browserLang = navigator.language.split('-')[0];
      const defaultLang = 'fr';
      const supportedLangs = ['fr', 'en'];
      
      let targetLang = defaultLang;
      if (storedLang && supportedLangs.includes(storedLang)) {
        targetLang = storedLang;
      } else if (browserLang && supportedLangs.includes(browserLang)) {
        targetLang = browserLang;
      }
      
      window.location.replace('/' + targetLang + '/');
    })();
  </script>
</head>
<body>
  <noscript>
    <p>Redirection vers <a href="/fr/">Arthur SERRET Portfolio (Français)</a> ou <a href="/en/">English</a>.</p>
  </noscript>
</body>
</html>
